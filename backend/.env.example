NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_USER=erpadmin
DB_PASSWORD=erppassword
DB_NAME=erp_system
DB_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Gmail SMTP (for OTP emails) ──────────────────────────────
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Select "Mail" + "Other device" → name it "IndustrialERP"
# 3. Copy the 16-character App Password Google gives you
# 4. Paste it as SMTP_PASS (no spaces)
# NOTE: 2-Step Verification must be ON in your Google account first.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
